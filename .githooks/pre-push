#!/usr/bin/env bash
# Git pre-push hook: run workspace validation before allowing a push.
# Git-native equivalent of the Devin pre-deploy hook (workspace-push gate).
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

if [[ -x scripts/workspace-validate.sh ]]; then
  echo "pre-push: running workspace-validate.sh" >&2
  if ! bash scripts/workspace-validate.sh; then
    echo "pre-push: validation failed, push blocked" >&2
    exit 1
  fi
elif [[ -f scripts/workspace-validate.sh ]]; then
  if ! bash scripts/workspace-validate.sh; then
    echo "pre-push: validation failed, push blocked" >&2
    exit 1
  fi
else
  echo "pre-push: no workspace-validate.sh found, skipping" >&2
fi
echo "pre-push: validation passed" >&2

# Live security-headers audit — verifies MUST header baseline on all zone
# hosts and that workers.dev endpoints stay disabled. Bypass with --no-verify.
if [[ -x scripts/security-headers-audit.sh ]]; then
  echo "pre-push: running security-headers-audit.sh" >&2
  if ! bash scripts/security-headers-audit.sh; then
    echo "pre-push: security audit failed, push blocked" >&2
    exit 1
  fi
  echo "pre-push: security audit passed" >&2
fi
exit 0
